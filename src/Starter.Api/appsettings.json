{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Debug",
      "System.Net.Http.HttpClient": "Debug"
    }
  },
  "AllowedHosts": "*",

  "Keycloak": {
    "Authority": "https://localhost:8080/",
    "Realm": "Starter",
    "Audience": "Starter-api",
    "Issuer": "http://localhost:8080/realms/Starter"
  },

  "services": {
    "keycloak": {
      "http": [
        "https://localhost:8080"
      ]
    }
  }
}
